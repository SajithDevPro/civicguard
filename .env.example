# ==============================================================================
# CIVICGUARD PUBLIC SAFETY PLATFORM - ENVIRONMENT CONFIGURATION
# ==============================================================================

# AI Studio runtime keys
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"

# Supabase PostgreSQL & PostGIS Backend
# Obtain these from your Supabase project settings -> API
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"

# Tactical Map & CartoDB Vector Tiles (Default: CartoDB Dark Matter)
VITE_MAP_TILE_URL="https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png"

# Application Environment Mode (development | staging | production)
VITE_APP_ENV="development"
